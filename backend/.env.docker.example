# Cấu hình cho container `app` (docker compose --profile app). Sao chép thành backend/.env.docker rồi điền.
# NODE_ENV=production được đặt trong Dockerfile: DEMO_MODE phải là false, và thư xác minh email cần SMTP thật
# (chưa có: tạo tài khoản bằng CLI hoặc để SIGNUP_MODE=closed).

# Địa chỉ HTTPS công khai (tunnel hoặc tên miền), không có dấu / ở cuối.
PUBLIC_BASE_URL=https://changeme.example.com

# Meta App (Settings > Basic). Không dán App Secret vào chat hay commit.
FB_APP_ID=changeme
APP_SECRET=changeme
VERIFY_TOKEN=changeme
GRAPH_API_VERSION=v26.0

# Khóa mã hóa Page token: base64 của đúng 32 byte. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=changeme

DEMO_MODE=false
SIGNUP_MODE=closed

# AI: offline (mặc định) hoặc live (cần ANTHROPIC_API_KEY).
AI_MODE=offline
# ANTHROPIC_API_KEY=
