# Giá trị mẫu, KHÔNG phải bí mật thật. Sao chép thành .env rồi điền giá trị thật.

# App ID của Meta App (Settings > Basic). Dùng cho Facebook Login.
FB_APP_ID=changeme-app-id

# Tùy chọn: ID cấu hình Facebook Login for Business (App Dashboard). Meta khuyên dùng với app loại
# Business thay cho tham số scope. Bỏ trống thì dùng scope (Facebook Login thường). Nếu hộp thoại
# Facebook báo lỗi về quyền/scope, hãy tạo cấu hình trong Dashboard rồi điền ID vào đây.
# FB_LOGIN_CONFIG_ID=

# App Secret của Meta App (Settings > Basic). Dùng kiểm tra chữ ký X-Hub-Signature-256,
# đổi code lấy token, và tính appsecret_proof. KHÔNG commit, KHÔNG dán vào chat.
APP_SECRET=changeme-app-secret

# URL công khai (HTTPS) của server này, không có dấu / ở cuối. Khi dev là địa chỉ tunnel
# (ngrok hoặc cloudflared). Redirect URI của OAuth là PUBLIC_BASE_URL + /auth/facebook/callback:
# khai báo đúng chuỗi đó trong Meta App > Facebook Login > Settings > Valid OAuth Redirect URIs.
# Webhook URL khai báo trong Meta App là PUBLIC_BASE_URL + /webhook.
PUBLIC_BASE_URL=https://changeme.example.com

# Chuỗi tự đặt, khai báo lại trong Meta App khi đăng ký webhook (GET /webhook)
VERIFY_TOKEN=changeme-verify-token

# Khóa AES-256-GCM mã hóa Page token: 32 byte, mã hóa base64.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=changeme-base64-32-bytes

# Phiên bản Graph API. v26.0 ra mắt 29/07/2026 (theo changelog Meta, đối chiếu 09/11/2026).
# Kiểm tra lại https://developers.facebook.com/docs/graph-api/changelog/ trước khi lên production.
GRAPH_API_VERSION=v26.0

# PostgreSQL dev (docker-compose)
DATABASE_URL=postgres://salesmind:salesmind@localhost:5433/salesmind

# Database cho test. Tên database PHẢI kết thúc bằng _test (test sẽ xóa sạch schema).
# Có thể bỏ trống: mặc định trỏ vào salesmind_test của docker-compose.
# TEST_DATABASE_URL=postgres://salesmind:salesmind@localhost:5433/salesmind_test

# Tùy chọn: app_id của Page Inbox (tin nhân viên gõ tay trong hộp thư Page), cách nhau bằng dấu phẩy.
# Bỏ trống thì chấp nhận cả 263902037430900 và 26390203743090 (tài liệu Meta và thực tế lệch nhau, chưa xác minh).
# Sau khi xem một echo thật (cột app_id của bảng messages), điền giá trị thật vào đây.
# PAGE_INBOX_APP_IDS=

PORT=3000

# Đặt true khi chạy sau tunnel (ngrok, cloudflared), reverse proxy hoặc load balancer để Fastify lấy
# IP thật của client từ X-Forwarded-For (dùng cho giới hạn tốc độ). Để false nếu không có proxy.
TRUST_PROXY=false

# --- AI trích xuất (Module 2) ---
# offline (mặc định): luật tất định, không gọi mạng, không cần khóa. live: gọi Claude, cần ANTHROPIC_API_KEY.
# live gửi nội dung chat ra API nước ngoài: chỉ bật sau khi kiểm tra pháp lý (xem CLAUDE.md). Không tự bật khi có khóa.
AI_MODE=offline
# ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Chờ bấy nhiêu giây sau tin khách mới nhất rồi mới trích (gom tin liên tiếp). Demo: 3.
AI_DEBOUNCE_SECONDS=30
AI_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGES=30

# --- Demo ---
# true: bật API demo /api/*, đồng hồ tua được, công cụ giả lập tin nhắn. KHÔNG có đăng nhập; chỉ nghe localhost;
# bị từ chối khi NODE_ENV=production.
DEMO_MODE=false

# --- Tài khoản (P1) ---
# closed (mặc định): chỉ tạo tài khoản bằng CLI (user:create) hoặc lời mời. open: ai cũng đăng ký được.
SIGNUP_MODE=closed
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
