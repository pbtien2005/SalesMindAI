{
  "name": "salesmind-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SalesMind AI - Module 1: tiếp nhận tin nhắn từ Facebook Page",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "cli": "tsx --env-file=.env src/cli/index.ts",
    "db:migrate:prod": "node --env-file=.env dist/db/migrate.js",
    "eval:extraction": "tsx --env-file=.env scripts/eval-extraction.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
